# argus configuration
# Place this file as .env in your working directory or in ~/.argus/.env

# Discord Bot Token (used to query Discord API for user metadata, badges, avatars)
# Get one by creating a bot application at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# CordCat API Key (used for Discord historical usernames, FiveM/CFX lookups, indexers)
# Register at https://cord.cat / https://api.cord.cat
CORDCAT_API_KEY=

# Have I Been Pwned API Key (used for breach/exposure lookups on discovered emails)
# Obtain an API key from https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# LeakCheck API Key (alternative or complementary breach lookup service)
# Obtain from https://leakcheck.io
LEAKCHECK_API_KEY=

# GitHub Personal Access Token (optional, raises rate limits from 60 to 5,000 req/hr)
# Create a fine-grained or classic token with public access at https://github.com/settings/tokens
GITHUB_TOKEN=
